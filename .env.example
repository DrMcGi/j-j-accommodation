NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. Never expose the server secret using a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Ozow One API credentials. Use separate staging credentials and database first.
OZOW_ENV=staging
OZOW_CLIENT_ID=
OZOW_CLIENT_SECRET=
OZOW_SITE_CODE=
OZOW_WEBHOOK_SECRET=

# Email delivery using Resend; EMAIL_FROM must be a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=jjgrootboom405@gmail.com
BOOKING_NOTIFY_EMAIL=jjgrootboom405@gmail.com

# Protect the scheduled notification dispatcher. Use a long random secret.
CRON_SECRET=
NOTIFICATIONS_CRON_CONFIGURED=false
